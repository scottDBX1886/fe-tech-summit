{
  "datasets": [
    {
      "name": "ds_usage_by_endpoint",
      "displayName": "Usage by endpoint (app / coding agent / MCP)",
      "queryLines": [
        "SELECT COALESCE(se.endpoint_name, 'unknown') AS endpoint_name,\n",
        "       CASE\n",
        "         WHEN se.endpoint_name = 'sentinel-unity-gateway' THEN 'App (Sentinel)'\n",
        "         WHEN se.endpoint_name LIKE '%codex%' OR se.endpoint_name LIKE '%coding%' THEN 'Coding agent'\n",
        "         WHEN se.endpoint_name LIKE '%slack%' OR se.endpoint_name LIKE '%mcp%' THEN 'MCP'\n",
        "         ELSE 'Other / foundation' END AS resource_class,\n",
        "       COUNT(*) AS calls,\n",
        "       SUM(eu.input_token_count + eu.output_token_count) AS total_tokens\n",
        "FROM system.serving.endpoint_usage eu\n",
        "LEFT JOIN system.serving.served_entities se ON eu.served_entity_id = se.served_entity_id\n",
        "WHERE eu.workspace_id = '7474646890712007' AND eu.request_time >= current_date() - 7\n",
        "GROUP BY se.endpoint_name, 2\n",
        "ORDER BY calls DESC"
      ]
    },
    {
      "name": "ds_daily_usage",
      "displayName": "Daily usage trend",
      "queryLines": [
        "SELECT DATE_TRUNC('DAY', eu.request_time) AS day,\n",
        "       COUNT(*) AS calls,\n",
        "       SUM(eu.input_token_count + eu.output_token_count) AS total_tokens\n",
        "FROM system.serving.endpoint_usage eu\n",
        "WHERE eu.workspace_id = '7474646890712007' AND eu.request_time >= current_date() - 14\n",
        "GROUP BY DATE_TRUNC('DAY', eu.request_time)\n",
        "ORDER BY day"
      ]
    },
    {
      "name": "ds_governance_outcomes",
      "displayName": "Governance outcomes (guardrail blocks)",
      "queryLines": [
        "SELECT CASE\n",
        "         WHEN response LIKE '%input_guardrail_triggered%' THEN 'Guardrail blocked'\n",
        "         WHEN status_code = 200 THEN 'Allowed'\n",
        "         ELSE 'Other (4xx)' END AS outcome,\n",
        "       COUNT(*) AS n\n",
        "FROM serverless_scottj_techsummit_catalog.unity_gateway.sentinel_app_payload\n",
        "GROUP BY 1\n",
        "ORDER BY n DESC"
      ]
    },
    {
      "name": "ds_kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_calls,\n",
        "  SUM(input_token_count + output_token_count) AS total_tokens,\n",
        "  COUNT(DISTINCT requester) AS distinct_requesters\n",
        "FROM system.serving.endpoint_usage\n",
        "WHERE workspace_id = '7474646890712007' AND request_time >= current_date() - 7"
      ]
    },
    {
      "name": "ds_guardrail_kpi",
      "displayName": "Guardrail block count",
      "queryLines": [
        "SELECT COUNT(*) AS guardrail_blocks\n",
        "FROM serverless_scottj_techsummit_catalog.unity_gateway.sentinel_app_payload\n",
        "WHERE response LIKE '%input_guardrail_triggered%'"
      ]
    }
  ],

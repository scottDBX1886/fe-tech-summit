{
  "name": "sentinel-payment-integrity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "appkit plugin sync --write",
    "db:generate": "drizzle-kit generate",
    "predev": "npm run sync && npm run db:generate",
    "dev": "tsx watch server/server.ts",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prebuild": "npm run sync && npm run db:generate",
    "build:source": "tsdown --config tsdown.server.config.ts && vite build --config client/vite.config.ts",
    "build": "npm run build:source"
  },
  "dependencies": {
    "@databricks/appkit": "0.66.1",
    "@databricks/appkit-ui": "0.66.1",
    "@openai/agents": "0.17.0",
    "drizzle-orm": "0.45.2",
    "express": "4.22.2",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.33.0",
    "mlflow-tracing": "0.1.3",
    "openai": "^7.2.0",
    "pg": "8.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "16.6.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "0.22.14",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "^4.1.11"
  }
}

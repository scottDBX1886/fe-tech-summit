# Container installs against the PUBLIC registry (it can't reach the internal
# proxy). build-app.sh rewrites any proxy URLs in the lockfile → public before
# deploy, so do NOT pin `registry=` here (a proxy override would fight that and
# 404 in the container). For LOCAL installs behind the proxy, pass
# `--registry https://npm-proxy.cloud.databricks.com/` explicitly.
legacy-peer-deps=true
ignore-scripts=true

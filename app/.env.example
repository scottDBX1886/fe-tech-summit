# Sentinel Payment Integrity — local + deploy env (EXAMPLE / committed).
#
# Copy to `.env` (git-ignored) and fill the Lakebase connection fields.
# start.sh validates these strictly before booting; see its header for rules.
#
# The values below are the REAL fe-tech workshop resources this build targets.
# Auth: the launcher injects DATABRICKS_CONFIG_FILE / _PROFILE at spawn — do
# NOT set those (or DATABRICKS_TOKEN / PGPASSWORD) here (Lakebase uses OAuth).

# ── Workspace ────────────────────────────────────────────────────────────
DATABRICKS_HOST=https://fe-sandbox-serverless-scottj-techsummit.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=df0e3a1f950f617a

# ── Governed data (Build 1 Gold tables) ─────────────────────────────────
# Read by config/app.json (data.catalog/schema) → the boot-time Delta→Lakebase
# sync (server/db/sync.ts) + the analytics chart queries (config/queries/*.sql).
DEMO_CATALOG=serverless_scottj_techsummit_catalog
DEMO_SCHEMA=sent_benefits

# ── ask_data backend (pick ONE — Sentinel default is Genie) ──────────────
# The "Sentinel Payment Integrity" Genie space in fe-tech.
GENIE_SPACE_ID=01f1a23080a2179688ecae418471b534
# MAS_ENDPOINT_NAME=            # leave empty when using Genie

# ── Lakebase (Autoscale) — connection ────────────────────────────────────
# The instance backing this app. Fill PGHOST / LAKEBASE_ENDPOINT / PGDATABASE
# from `scripts/lakebase_setup_db.sh --project-id sentinel-payments` output.
LAKEBASE_PROJECT_ID=sentinel-payments
LAKEBASE_BRANCH_ID=production
# LAKEBASE_ENDPOINT must be a RESOURCE PATH (not a hostname):
#   projects/sentinel-payments/branches/production/endpoints/primary
LAKEBASE_ENDPOINT=projects/sentinel-payments/branches/production/endpoints/primary
# PGHOST is the DNS hostname (ep-xxx.database.<region>.cloud.databricks.com)
# from `databricks postgres get-endpoint <LAKEBASE_ENDPOINT>` → .spec.host.
PGHOST=
PGDATABASE=databricks_postgres
# PGUSER is set to your identity by lakebase_setup_db.sh; PGPORT/PGSSLMODE
# are injected by the platform in deployment.

# ── Deploy target (scripts/deploy.sh) ────────────────────────────────────
APP_NAME=sentinel-payment-integrity
